# Copie este ficheiro para `.env` e preencha. Nunca commite segredos.
#
# Produção: replique todas as variáveis VITE_* nas environment variables da plataforma de deploy.

# Supabase Dashboard → Settings → API (somente anon / publishable no front)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Landing — Google Maps (Partilhar > incorporar, ou Embed API opcional)
VITE_GOOGLE_MAPS_EMBED_SRC=
VITE_GOOGLE_MAPS_API_KEY=

# Opcional — Prisma CLI / servidor (nunca use prefixo VITE_ para isto):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
